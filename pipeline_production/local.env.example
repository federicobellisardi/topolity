# Copy to pipeline_production/local.env (not versioned) and adapt to the machine.
# Python interpreter of the project environment (environment.yml / requirements-lock.txt):
PY=/path/to/envs/geo_flow/bin/python
# Slurm submission helper used by submit_rerun_v2.sh and the runlog_* scripts (cluster specific):
RUNLOG=/path/to/runlog
